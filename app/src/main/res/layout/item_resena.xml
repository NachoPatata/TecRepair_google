<?xml version="1.0" encoding="utf-8"?>
<!-- Una reseña (se agrega desde el código a la pantalla de detalle) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="1dp"
    android:background="@color/blanco"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circulo"
        android:contentDescription="Avatar"
        android:padding="8dp"
        android:src="@drawable/ic_persona" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtAutorResena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/negro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtFechaResena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/gris_texto"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtTextoResena"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/negro"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtEstrellasResena"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/gris_texto"
        android:textSize="14sp" />
</LinearLayout>

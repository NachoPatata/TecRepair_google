<?xml version="1.0" encoding="utf-8"?>
<!-- DrawerLayout = Navigation Drawer (menú lateral deslizable desde la izquierda) -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Contenido principal de la pantalla -->
    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gris_fondo"
        android:orientation="vertical">

        <!-- Encabezado: menú hamburguesa, título y avatar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="Abrir menú"
                android:src="@drawable/ic_menu" />

            <TextView
                android:id="@+id/txtTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_weight="1"
                android:text="TecRepair"
                android:textColor="@color/negro"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circulo"
                android:contentDescription="Perfil"
                android:padding="8dp"
                android:src="@drawable/ic_persona" />
        </LinearLayout>

        <!-- Buscador (se oculta en Favoritos) -->
        <EditText
            android:id="@+id/edtBuscar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_buscador"
            android:drawableStart="@drawable/ic_buscar"
            android:drawablePadding="12dp"
            android:drawableTint="@color/gris_texto"
            android:hint="Buscar"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/negro"
            android:textColorHint="@color/gris_texto"
            android:textSize="16sp" />

        <!-- Chips de categoría con scroll horizontal -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipComputacion"
                    style="@style/ChipCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Computación" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTelefonia"
                    style="@style/ChipCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telefonía" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipImpresoras"
                    style="@style/ChipCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Impresoras" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipConsolas"
                    style="@style/ChipCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consolas" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Filtro extra: diagnóstico gratis (se puede combinar con la categoría) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                app:singleLine="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDiagnostico"
                    style="@style/ChipCategoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diagnóstico gratis" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Lista de técnicos + mensaje de lista vacía -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTecnicos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/txtVacio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:drawablePadding="12dp"
                android:drawableTop="@drawable/ic_favorito"
                android:drawableTint="@color/gris_texto"
                android:gravity="center"
                android:text="Aún no tienes favoritos"
                android:textColor="@color/gris_texto"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Barra inferior: Inicio, Explorar, Favoritos -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/blanco"
            app:labelVisibilityMode="unlabeled"
            app:menu="@menu/menu_inferior" />
    </LinearLayout>

    <!-- Menú lateral (Navigation Drawer) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/menu_lateral" />

</androidx.drawerlayout.widget.DrawerLayout>
